{
  "name": "prunak",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Prunak — portfolio of photographer Panagiota Karagiorgou",
  "scripts": {
    "dev": "vite",
    "check:assets": "node scripts/check-assets.mjs",
    "gen:seo": "node scripts/gen-seo.mjs",
    "prebuild": "npm run check:assets && npm run gen:seo",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/check-dist.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/gfs-didot": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "marked": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
